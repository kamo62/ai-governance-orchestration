# ai-orch local development environment template
# Copy to .env.dev and fill only the values you need.

AI_ORCH_ENV=local
AI_ORCH_GOVERNANCE_URL=http://127.0.0.1:18080
AI_ORCH_ORCHESTRATOR_URL=http://127.0.0.1:8081
AI_ORCH_MODEL_GATEWAY_URL=http://127.0.0.1:18082

AI_ORCH_DEV_TOKEN=local-dev
AI_ORCH_ADMIN_TOKEN=local-admin
AI_ORCH_SERVICE_TOKEN=local-service-token
AI_ORCH_RUNTIME_TOKEN=local-runtime-token
AI_ORCH_TRUSTED_CLIENT_TOKEN=local-trusted-client-token
AI_ORCH_ACTOR_SUBJECT=
AI_ORCH_INTENT=

AI_ORCH_MODEL_BACKEND=bifrost
AI_ORCH_MODEL_ALIAS_OVERRIDE=
AI_ORCH_GATEWAY_MODEL=smoke-deepseek-v4-flash
AI_ORCH_GATEWAY_CLASSIFICATION=internal
AI_ORCH_GATEWAY_AUTO_SESSION=true

# Optional Copilot per-user backend. Opt in by setting:
# AI_ORCH_MODEL_BACKEND=copilot-user
# AI_ORCH_MODEL_ALIAS_OVERRIDE=copilot-gpt-5-mini
# AI_ORCH_GATEWAY_MODEL=copilot-gpt-5-mini
# AI_ORCH_COPILOT_TOKEN_ENCRYPTION_KEY=<local encryption key>
AI_ORCH_COPILOT_TOKEN_DB=
AI_ORCH_COPILOT_TOKEN_ENCRYPTION_KEY=
AI_ORCH_COPILOT_KEY_FILE=
AI_ORCH_OPENCODE_SCOPE=global

GOVERNANCE_SHELL_PORT=18080
MODEL_GATEWAY_PORT=18082

AI_ORCH_SMOKE_HTTP_TIMEOUT=45s
AI_ORCH_SMOKE_SSE_TIMEOUT=180s
AI_ORCH_GATEWAY_MAX_TOKENS=512

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ALIAS=smoke-deepseek-v4-flash

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
