{
  "name": "ai-agent-bridge",
  "displayName": "AI Agent Bridge",
  "description": "Governed AI agent panel for VS Code — chat, streaming, context attachments, and patch review via the Governance Shell",
  "version": "0.20.3-beta",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamo62/ai-governance-orchestration.git",
    "directory": "ai-agent-orch/agent-bridge"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onView:aiAgentBridge.agentPanel",
    "onCommand:aiAgentBridge.invokeAgent",
    "onCommand:aiAgentBridge.onboard",
    "onCommand:aiAgentBridge.checkConnection",
    "onCommand:aiAgentBridge.showAudit",
    "onCommand:aiAgentBridge.focusPanel",
    "onCommand:aiAgentBridge.attachSelection",
    "onCommand:aiAgentBridge.attachActiveFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiAgentBridge",
          "title": "AI Agent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "aiAgentBridge": [
        {
          "type": "webview",
          "id": "aiAgentBridge.agentPanel",
          "name": "Bridge",
          "icon": "$(hubot)"
        }
      ]
    },
    "commands": [
      {
        "command": "aiAgentBridge.focusPanel",
        "title": "Open AI Agent Panel",
        "category": "AI Agent",
        "icon": "$(hubot)"
      },
      {
        "command": "aiAgentBridge.invokeAgent",
        "title": "Invoke AI Agent",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentBridge.onboard",
        "title": "Setup AI Agent Bridge",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentBridge.checkConnection",
        "title": "Check AI Agent Bridge Connection",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentBridge.showAudit",
        "title": "Show Session Audit",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentBridge.attachSelection",
        "title": "Attach Selection to Agent Context",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentBridge.attachActiveFile",
        "title": "Attach Active File to Agent Context",
        "category": "AI Agent"
      }
    ],
    "keybindings": [
      {
        "command": "aiAgentBridge.focusPanel",
        "key": "cmd+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiAgentBridge.checkConnection",
          "when": "view == aiAgentBridge.agentPanel",
          "group": "navigation@1"
        },
        {
          "command": "aiAgentBridge.onboard",
          "when": "view == aiAgentBridge.agentPanel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aiAgentBridge.focusPanel"
        },
        {
          "command": "aiAgentBridge.invokeAgent"
        },
        {
          "command": "aiAgentBridge.onboard"
        },
        {
          "command": "aiAgentBridge.checkConnection"
        },
        {
          "command": "aiAgentBridge.showAudit"
        },
        {
          "command": "aiAgentBridge.attachSelection"
        },
        {
          "command": "aiAgentBridge.attachActiveFile"
        }
      ],
      "editor/context": [
        {
          "command": "aiAgentBridge.attachSelection",
          "when": "editorHasSelection",
          "group": "aiAgent@1"
        },
        {
          "command": "aiAgentBridge.attachActiveFile",
          "group": "aiAgent@2"
        }
      ]
    },
    "configuration": {
      "title": "AI Agent Bridge",
      "properties": {
        "aiAgentBridge.governanceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18080",
          "scope": "machine",
          "description": "URL of the AI Agent Orchestrator governance server."
        },
        "aiAgentBridge.devToken": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Developer authentication token for the orchestrator. Falls back to AI_ORCH_DEV_TOKEN environment variable."
        },
        "aiAgentBridge.identity": {
          "type": "string",
          "default": "developer",
          "scope": "machine",
          "description": "Identity label for audit and session attribution (e.g., developer, ci-bot, review-assistant)."
        },
        "aiAgentBridge.trustedClientToken": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Trusted client token sent as X-AI-Orch-Trusted-Client-Token. Falls back to AI_ORCH_TRUSTED_CLIENT_TOKEN."
        },
        "aiAgentBridge.autoConfirmSpecialist": {
          "type": "boolean",
          "default": false,
          "description": "Skip the specialist confirmation step and start execution immediately after routing."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "package": "bunx @vscode/vsce package --out ai-agent-bridge.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
